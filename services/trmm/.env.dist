# Tactical RMM — environment template
# Copy to .env and fill in all values before running trmm-setup.sh.
# Never commit .env to the repository.

# ── TRMM image version ────────────────────────────────────────────────────────
# Pin to a specific release tag for reproducible deploys.
# Latest releases: https://github.com/amidaware/tacticalrmm/releases
TRMM_VERSION=latest

# ── Public subdomains (must have DNS A records pointing to this VM's IP) ──────
APP_HOST=rmm.yourdomain.com
API_HOST=api.yourdomain.com
MESH_HOST=mesh.yourdomain.com

# ── MeshCentral admin credentials ─────────────────────────────────────────────
MESH_USER=meshcentral
MESH_PASS=ChangeMeshPassword!

# ── Django ────────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=CHANGE_ME_django_secret_key

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=tactical
POSTGRES_PASS=ChangeTRMMDbPassword!
POSTGRES_DB=tacticalrmm

# ── Internal service addresses (defaults match container names) ───────────────
REDIS_HOST=tactical-redis
DB_HOST=tactical-postgres

# ── Timezone ──────────────────────────────────────────────────────────────────
TZ=America/Sao_Paulo
