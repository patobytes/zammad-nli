# .env.prod — Production environment template
# Secrets are injected by the Bicep deployment; this file is for reference only.
# Copy to .env on the VM and fill in values if running vm-setup.sh manually.

# ── Zammad ───────────────────────────────────────────────
POSTGRES_PASS=<set-by-bicep>
NGINX_EXPOSE_PORT=80
TZ=America/Sao_Paulo
ZAMMAD_HTTP_TYPE=http
ZAMMAD_FQDN=<azure-auto-generated-or-custom-domain>

# ── HTTPS (optional — configure after initial deployment) ─
# To enable HTTPS, either:
#   1. Install certbot on the VM host and add a reverse proxy (nginx/caddy)
#   2. Put Azure Application Gateway or Azure Front Door in front of the VM
# Then update ZAMMAD_HTTP_TYPE=https and ZAMMAD_FQDN to your domain.

# ── Elasticsearch (disabled by default) ──────────────────
# Zammad 6+ uses PostgreSQL full-text search as fallback.
# Enable Elasticsearch for large instances (>10k tickets).
# ELASTICSEARCH_ENABLED=true
